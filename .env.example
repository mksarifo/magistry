# UI and Docker registry share one port. Loopback only by default.
BIND_ADDRESS=127.0.0.1
PORT=5050
PUBLIC_REGISTRY=localhost:5050

# Optional administrator supplied by the environment; otherwise create it in the UI.
# Put passwords containing $ inside single quotes in this file.
AUTH_USERNAME=
AUTH_PASSWORD=
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
